<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodes="using:SeWZC.WorldBox.UI.ViewModels.Details" xmlns:views="using:SeWZC.WorldBox.UI.Views"
             x:Class="SeWZC.WorldBox.UI.Views.DetailView" x:CompileBindings="True" x:DataType="nodes:VisualNode">
    <UserControl.Resources>
        <ControlTheme x:Key="DetailItemContainer" TargetType="ContentPresenter" x:DataType="nodes:VisualNode">
            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Canvas.Left" Value="{Binding Left}" /><Setter Property="Canvas.Top" Value="{Binding Top}" />
            <Setter Property="Grid.Column" Value="{Binding Column}" /><Setter Property="Grid.Row" Value="{Binding Row}" />
            <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" /><Setter Property="Grid.RowSpan" Value="{Binding RowSpan}" />
        </ControlTheme>
    </UserControl.Resources>
    <UserControl.DataTemplates>
        <DataTemplate DataType="nodes:StackNode" x:DataType="nodes:StackNode">
            <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" ItemContainerTheme="{StaticResource DetailItemContainer}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="{Binding Orientation}" Spacing="{Binding Spacing}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate DataType="nodes:CanvasNode" x:DataType="nodes:CanvasNode">
            <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" ItemContainerTheme="{StaticResource DetailItemContainer}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate DataType="nodes:WrapNode" x:DataType="nodes:WrapNode">
            <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" ItemContainerTheme="{StaticResource DetailItemContainer}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="{Binding Orientation}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate DataType="nodes:GridNode" x:DataType="nodes:GridNode">
            <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" ItemContainerTheme="{StaticResource DetailItemContainer}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid views:GridDefinitions.Columns="{Binding ColumnDefinitions}" views:GridDefinitions.Rows="{Binding RowDefinitions}" ColumnSpacing="{Binding ColumnSpacing}" RowSpacing="{Binding RowSpacing}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate DataType="nodes:TextNode" x:DataType="nodes:TextNode">
            <TextBlock IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding Foreground}" FontWeight="{Binding FontWeight}" TextWrapping="{Binding TextWrapping}" LineHeight="{Binding LineHeight}" />
        </DataTemplate>
        <DataTemplate DataType="nodes:ButtonNode" x:DataType="nodes:ButtonNode">
            <Button IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" Content="{Binding Content}" Command="{Binding Command}" FontSize="{Binding FontSize}" Background="{Binding Background}" Foreground="{Binding Foreground}" BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}" CornerRadius="{Binding CornerRadius}" Padding="{Binding Padding}" HorizontalContentAlignment="{Binding HorizontalContentAlignment}" VerticalContentAlignment="{Binding VerticalContentAlignment}" />
        </DataTemplate>
        <DataTemplate DataType="nodes:CheckNode" x:DataType="nodes:CheckNode">
            <CheckBox IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" Content="{Binding Content}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
        </DataTemplate>
        <DataTemplate DataType="nodes:TextInputNode" x:DataType="nodes:TextInputNode">
            <TextBox IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" Text="{Binding Text, Mode=TwoWay}" MaxLength="{Binding MaxLength}" PlaceholderText="{Binding PlaceholderText}" AcceptsReturn="{Binding AcceptsReturn}" IsReadOnly="{Binding IsReadOnly}" TextWrapping="{Binding TextWrapping}" FontSize="{Binding FontSize}" />
        </DataTemplate>
        <DataTemplate DataType="nodes:NumberNode" x:DataType="nodes:NumberNode">
            <NumericUpDown IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" Value="{Binding Value, Mode=TwoWay}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Increment="{Binding Increment}" FormatString="{Binding FormatString}" NumberFormat="{Binding NumberFormat}" />
        </DataTemplate>
        <DataTemplate DataType="nodes:ChoiceNode" x:DataType="nodes:ChoiceNode">
            <ComboBox IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" ItemsSource="{Binding Choices}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="nodes:ChoiceNode+ChoiceLabel"><TextBlock Text="{Binding Label}" FontSize="12" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>
        <DataTemplate DataType="nodes:BorderNode" x:DataType="nodes:BorderNode">
            <Border IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}" CornerRadius="{Binding CornerRadius}" Padding="{Binding Padding}" ClipToBounds="{Binding ClipToBounds}"><ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding Child}" /></Border>
        </DataTemplate>
        <DataTemplate DataType="nodes:ExpanderNode" x:DataType="nodes:ExpanderNode">
            <Expander IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" Header="{Binding Header}" Content="{Binding Content}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="{Binding HorizontalContentAlignment}" />
        </DataTemplate>
        <DataTemplate DataType="nodes:TabsNode" x:DataType="nodes:TabsNode">
            <TabControl IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" ItemsSource="{Binding ItemsSource}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
                <TabControl.ItemTemplate><DataTemplate x:DataType="nodes:TabNode"><ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding Header}" AutomationProperties.AutomationId="{Binding AutomationId}" /></DataTemplate></TabControl.ItemTemplate>
                <TabControl.ContentTemplate><DataTemplate x:DataType="nodes:TabNode"><ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding Content}" /></DataTemplate></TabControl.ContentTemplate>
            </TabControl>
        </DataTemplate>
        <DataTemplate DataType="nodes:ImageNode" x:DataType="nodes:ImageNode">
            <Image IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" Source="{Binding Source}" Stretch="{Binding Stretch}" />
        </DataTemplate>
        <DataTemplate DataType="nodes:GlyphNode" x:DataType="nodes:GlyphNode">
            <Path IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" Width="{Binding Width}" Height="{Binding Height}" MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" HorizontalAlignment="{Binding HorizontalAlignment}" VerticalAlignment="{Binding VerticalAlignment}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding ToolTip}" views:NodeLifetime.Node="{Binding}" Data="{Binding Data}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Stretch="{Binding Stretch}" />
        </DataTemplate>
    </UserControl.DataTemplates>
    <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding}" />
</UserControl>
