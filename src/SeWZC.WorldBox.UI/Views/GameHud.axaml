<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="using:SeWZC.WorldBox.UI.Views"
             xmlns:vm="using:SeWZC.WorldBox.UI.ViewModels"
             x:Class="SeWZC.WorldBox.UI.Views.GameHud"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True" d:DesignWidth="1440" d:DesignHeight="920" d:DataContext="{x:Static vm:DesignData.Main}">
    <UserControl.Styles>
        <Style Selector="Border.hud">
            <Setter Property="Background" Value="#F0172632" />
            <Setter Property="BorderBrush" Value="#42545B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Button.speed">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="40" />
        </Style>
        <Style Selector="Button.speed.selected">
            <Setter Property="Background" Value="#355347" />
            <Setter Property="Foreground" Value="#B8E9BC" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Grid Margin="10" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Border x:Name="WorldReadout" Classes="hud" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding WorldDate}" FontSize="13" AutomationProperties.AutomationId="world-date" />
                        <TextBlock Grid.Column="1" x:Name="ViewpointLabel" Text="{Binding Viewpoint}" FontSize="12" Foreground="#8FA8AE" />
                    </Grid>
                    <Button Content="返回观察位置" Command="{Binding NavigateCommand}" CommandParameter="return-observation"
                            IsVisible="{Binding CanReturnObservation}" AutomationProperties.AutomationId="map-return-observation" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding TimeState}" TextWrapping="Wrap" FontSize="13" Foreground="#B8E9BC" AutomationProperties.AutomationId="time-state" />
                        <Border Grid.Column="1" Width="76" IsHitTestVisible="False" IsVisible="{Binding ShowPerformance}"><TextBlock Text="{Binding PerformanceText}" FontSize="10" Foreground="#B8E9BC" VerticalAlignment="Center" AutomationProperties.AutomationId="performance-stats" /></Border>
                    </Grid>
                </StackPanel>
            </Border>
            <Button Grid.Column="1" x:Name="WorldMenu" Content="世界" Command="{Binding NavigateCommand}" CommandParameter="menu"
                    VerticalAlignment="Top" AutomationProperties.AutomationId="world-menu" />
        </Grid>
        <Border Grid.Row="1" x:Name="EventNotice" Classes="hud" Width="320" Margin="10,0,10,8"
                HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding EventVisible}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                <TextBlock Text="世界动态" FontSize="12" Foreground="#E4C889" />
                <Button Grid.Column="1" Content="收起" Command="{Binding DismissEventCommand}"
                        AutomationProperties.AutomationId="event-dismiss" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding EventText}" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis" FontSize="13" />
                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding EventTitle}" TextWrapping="Wrap" FontSize="11" Foreground="#8FA8AE" />
                    <Button Grid.Column="1" Content="查看事件" Command="{Binding NavigateCommand}" CommandParameter="event"
                            AutomationProperties.AutomationId="event-spotlight" />
                </Grid>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="10,8" Spacing="8" HorizontalAlignment="Center">
            <ContentControl x:Name="ToolHost" Content="{Binding $parent[views:GameHud].ToolContent}" IsVisible="{Binding ToolsVisible}" />
            <Border x:Name="SelectionSummary" Classes="hud" IsVisible="{Binding SelectionVisible}"
                    AutomationProperties.AutomationId="selection-summary">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                    <TextBlock Text="{Binding SelectionTitle}" FontSize="14" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="#B8E9BC" AutomationProperties.AutomationId="selection-name" />
                    <Button Grid.Column="1" Content="×" Command="{Binding NavigateCommand}" CommandParameter="clear"
                            ToolTip.Tip="取消选择" AutomationProperties.Name="取消选择" AutomationProperties.AutomationId="selection-clear" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SelectionDescription}" IsVisible="{Binding SelectionDescriptionVisible}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="13" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="查看详情" Command="{Binding NavigateCommand}" CommandParameter="selection" AutomationProperties.AutomationId="selection-view" />
                        <Button Content="定位" Command="{Binding NavigateCommand}" CommandParameter="locate" AutomationProperties.AutomationId="selection-locate" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        <Grid Grid.Row="3" Margin="10,0,10,8" RowDefinitions="Auto,Auto" RowSpacing="5">
            <Grid x:Name="Dock" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                <Border x:Name="ObservationDock" Classes="hud" Grid.Column="0" Padding="5">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="塑造世界" Command="{Binding NavigateCommand}" CommandParameter="tools" AutomationProperties.AutomationId="tools-toggle" />
                        <Button Content="漫游" Command="{Binding NavigateCommand}" CommandParameter="pan" AutomationProperties.AutomationId="tool-suspend" />
                        <Button Content="记录" Command="{Binding NavigateCommand}" CommandParameter="history" AutomationProperties.AutomationId="hud-history" />
                        <Button Content="关注" Command="{Binding NavigateCommand}" CommandParameter="watched" AutomationProperties.AutomationId="hud-watched" />
                        <Button Content="撤销" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoHint}" AutomationProperties.AutomationId="world-undo" />
                    </StackPanel>
                </Border>
                <Border x:Name="TimeDock" Classes="hud" Grid.Column="2" Padding="5" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}" Background="#B8E9BC" Foreground="#111E29" MinWidth="56"
                                ToolTip.Tip="空格：暂停或继续" AutomationProperties.AutomationId="time-toggle" />
                        <Button Content="1倍" Classes="speed" Classes.selected="{Binding IsNormalSpeed}" Command="{Binding SpeedCommand}" CommandParameter="1" AutomationProperties.AutomationId="time-speed-1" />
                        <Button Content="2倍" Classes="speed" Classes.selected="{Binding IsDoubleSpeed}" Command="{Binding SpeedCommand}" CommandParameter="2" AutomationProperties.AutomationId="time-speed-2" />
                        <Button Content="5倍" Classes="speed" Classes.selected="{Binding IsFastSpeed}" Command="{Binding SpeedCommand}" CommandParameter="5" AutomationProperties.AutomationId="time-speed-5" />
                        <Button Content="不限速" Classes="speed" Classes.selected="{Binding IsUnlimitedSpeed}" Command="{Binding SpeedCommand}" CommandParameter="0" AutomationProperties.AutomationId="time-speed-unlimited" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Feedback}" FontSize="11" Foreground="#E9EFEB" TextTrimming="CharacterEllipsis"
                       MaxLines="1" AutomationProperties.AutomationId="game-feedback" />
        </Grid>
    </Grid>
</UserControl>
