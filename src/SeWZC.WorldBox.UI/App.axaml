<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SeWZC.WorldBox.UI.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <x:Double x:Key="ExpanderMinHeight">30</x:Double>
        <Thickness x:Key="ExpanderHeaderPadding">6,0,0,0</Thickness>
        <Thickness x:Key="ExpanderChevronMargin">4,0,4,0</Thickness>
        <x:Double x:Key="ExpanderChevronButtonSize">18</x:Double>
        <Thickness x:Key="ExpanderContentPadding">6,4</Thickness>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <!-- String content in CheckBox uses AccessText, a TextBlock subclass. -->
        <Style Selector=":is(TextBlock)">
            <Setter Property="FontFamily"
                    Value="avares://SeWZC.WorldBox.UI/Assets/Fonts/NotoSansSC.otf#Noto Sans CJK SC" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#E9EFEB" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily"
                    Value="avares://SeWZC.WorldBox.UI/Assets/Fonts/NotoSansSC.otf#Noto Sans CJK SC" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#213240" />
            <Setter Property="Foreground" Value="#DDE8E1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily"
                    Value="avares://SeWZC.WorldBox.UI/Assets/Fonts/NotoSansSC.otf#Noto Sans CJK SC" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontFamily"
                    Value="avares://SeWZC.WorldBox.UI/Assets/Fonts/NotoSansSC.otf#Noto Sans CJK SC" />
        </Style>
    </Application.Styles>
</Application>
