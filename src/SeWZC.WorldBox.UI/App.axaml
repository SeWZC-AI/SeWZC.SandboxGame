<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SeWZC.WorldBox.UI.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <!-- String content in CheckBox uses AccessText, a TextBlock subclass. -->
    <Style Selector=":is(TextBlock)">
      <Setter Property="FontFamily" Value="avares://SeWZC.WorldBox.UI/Assets/Fonts/NotoSansSC.otf#Noto Sans CJK SC" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E9EFEB" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="avares://SeWZC.WorldBox.UI/Assets/Fonts/NotoSansSC.otf#Noto Sans CJK SC" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#213240" />
      <Setter Property="Foreground" Value="#DDE8E1" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="avares://SeWZC.WorldBox.UI/Assets/Fonts/NotoSansSC.otf#Noto Sans CJK SC" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontFamily" Value="avares://SeWZC.WorldBox.UI/Assets/Fonts/NotoSansSC.otf#Noto Sans CJK SC" />
    </Style>
  </Application.Styles>
</Application>
